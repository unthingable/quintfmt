{
  "name": "quintfmt",
  "version": "0.1.0",
  "description": "A conservative, comment-preserving formatter for Quint.",
  "license": "MIT",
  "bin": {
    "quintfmt": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md", "LICENSE", "vendor/quint/UPSTREAM.md", "vendor/quint/LICENSE"],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "generate": "antlr4ts -visitor -o src/generated vendor/quint/Quint.g4",
    "build": "npm run clean && npm run generate && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "antlr4ts": "0.5.0-alpha.4",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "antlr4ts-cli": "0.5.0-alpha.4",
    "typescript": "5.8.3"
  }
}
